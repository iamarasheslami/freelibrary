<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Project Gutenberg's certificate comes from SSL.com, whose root (SSL.com TLS RSA Root CA 2022)
         is missing from the trust store of older Android versions. That root is added for
         gutenberg.org only; every other site keeps using the phone's own trust store. -->
    <domain-config>
        <domain includeSubdomains="true">gutenberg.org</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ssl_com_tls_rsa_root_ca_2022" />
        </trust-anchors>
    </domain-config>
</network-security-config>
