<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.freelibrary.app.ui.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_bookListFragment"
            app:destination="@id/bookListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_bookPageFragment"
            app:destination="@id/bookPageFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.freelibrary.app.ui.explore.ExploreFragment"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/action_exploreFragment_to_bookListFragment"
            app:destination="@id/bookListFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_bookPageFragment"
            app:destination="@id/bookPageFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.freelibrary.app.ui.search.SearchFragment"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_bookPageFragment"
            app:destination="@id/bookPageFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookListFragment"
        android:name="com.freelibrary.app.ui.booklist.BookListFragment"
        tools:layout="@layout/fragment_book_list">
        <argument
            android:name="kind"
            app:argType="string" />
        <argument
            android:name="titleRes"
            android:defaultValue="0"
            app:argType="reference" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="bookshelfName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="filtered"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_bookListFragment_to_bookPageFragment"
            app:destination="@id/bookPageFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookPageFragment"
        android:name="com.freelibrary.app.ui.bookpage.BookPageFragment"
        tools:layout="@layout/fragment_book_page">
        <argument
            android:name="bookId"
            app:argType="long" />
        <action
            android:id="@+id/action_bookPageFragment_to_epubReaderFragment"
            app:destination="@id/epubReaderFragment" />
        <action
            android:id="@+id/action_bookPageFragment_to_pdfReaderFragment"
            app:destination="@id/pdfReaderFragment" />
        <action
            android:id="@+id/action_bookPageFragment_to_textReaderFragment"
            app:destination="@id/textReaderFragment" />
        <action
            android:id="@+id/action_bookPageFragment_to_bookmarksFragment"
            app:destination="@id/bookmarksFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookmarksFragment"
        android:name="com.freelibrary.app.ui.bookmarks.BookmarksFragment"
        tools:layout="@layout/fragment_bookmarks">
        <argument
            android:name="bookId"
            app:argType="long" />
        <action
            android:id="@+id/action_bookmarksFragment_to_epubReaderFragment"
            app:destination="@id/epubReaderFragment" />
        <action
            android:id="@+id/action_bookmarksFragment_to_pdfReaderFragment"
            app:destination="@id/pdfReaderFragment" />
        <action
            android:id="@+id/action_bookmarksFragment_to_textReaderFragment"
            app:destination="@id/textReaderFragment" />
    </fragment>

    <fragment
        android:id="@+id/textReaderFragment"
        android:name="com.freelibrary.app.ui.reader.TextReaderFragment"
        tools:layout="@layout/fragment_text_reader">
        <argument
            android:name="startPosition"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="bookId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/pdfReaderFragment"
        android:name="com.freelibrary.app.ui.reader.PdfReaderFragment"
        tools:layout="@layout/fragment_pdf_reader">
        <argument
            android:name="startPosition"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="bookId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/epubReaderFragment"
        android:name="com.freelibrary.app.ui.reader.EpubReaderFragment"
        tools:layout="@layout/fragment_epub_reader">
        <argument
            android:name="startPosition"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="bookId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.freelibrary.app.ui.profile.ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_bookListFragment"
            app:destination="@id/bookListFragment" />
        <action
            android:id="@+id/action_profileFragment_to_bookPageFragment"
            app:destination="@id/bookPageFragment" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.freelibrary.app.ui.settings.SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.freelibrary.app.ui.profile.EditProfileFragment"
        tools:layout="@layout/fragment_edit_profile" />

</navigation>