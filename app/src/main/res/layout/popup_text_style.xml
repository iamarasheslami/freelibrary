<?xml version="1.0" encoding="utf-8"?>
<!-- The text panel of the readers: text size (smaller, a bar, larger, the size in percent), then drop-downs for the font and the colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_text_size_popup"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:padding="@dimen/spacing_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/textSizeSmaller"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_smaller_text"
            android:src="@drawable/ic_remove" />

        <com.google.android.material.slider.Slider
            android:id="@+id/textSizeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/reader_text_size" />

        <ImageButton
            android:id="@+id/textSizeLarger"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_larger_text"
            android:src="@drawable/ic_add" />

    </LinearLayout>

    <TextView
        android:id="@+id/textSizeValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/spacing_xs"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="@string/reader_font"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/readerFontField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_picker_field"
        android:clickable="true"
        android:drawablePadding="@dimen/spacing_s"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_s"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="@string/reader_text_colour"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/readerColourField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_picker_field"
        android:clickable="true"
        android:drawablePadding="@dimen/spacing_s"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_s"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

</LinearLayout>
