<?xml version="1.0" encoding="utf-8"?>
<!-- The text size control of the readers: smaller, a bar, larger, and the size in percent under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_text_size_popup"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:padding="@dimen/spacing_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/textSizeSmaller"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_smaller_text"
            android:src="@drawable/ic_remove" />

        <com.google.android.material.slider.Slider
            android:id="@+id/textSizeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/reader_text_size" />

        <ImageButton
            android:id="@+id/textSizeLarger"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_larger_text"
            android:src="@drawable/ic_add" />

    </LinearLayout>

    <TextView
        android:id="@+id/textSizeValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/spacing_xs"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
