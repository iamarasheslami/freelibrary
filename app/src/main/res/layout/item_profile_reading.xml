<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing_m"
    android:paddingEnd="@dimen/spacing_m"
    android:paddingBottom="@dimen/spacing_m">

    <LinearLayout
        android:id="@+id/readingCard"
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m">

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal">

                <com.freelibrary.app.ui.profile.GoalRingView
                    android:id="@+id/readingRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:ringColor="?attr/colorPrimary"
                    app:ringStroke="7dp"
                    app:trackColor="?attr/colorOutlineVariant" />

                <TextView
                    android:id="@+id/readingCount"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeTextType="uniform" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:minLines="2"
                android:text="@string/profile_finished_books_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/readingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/readingGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/readingMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal">

                <com.freelibrary.app.ui.profile.GoalRingView
                    android:id="@+id/streakRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:ringColor="?attr/colorTertiary"
                    app:ringStroke="7dp"
                    app:trackColor="?attr/colorOutlineVariant" />

                <TextView
                    android:id="@+id/streakCount"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="9sp"
                    app:autoSizeTextType="uniform" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:minLines="2"
                android:text="@string/profile_streak_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
