<?xml version="1.0" encoding="utf-8"?>
<!-- One icon button of the Book page. The root is 48dp wide, so the touch target is full size
     while the glass circle inside it is 36dp, which leaves a small gap between the circles; seven of
     them still fit one row on a 360dp phone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/bookActionIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_icon_button"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:tint="?attr/colorPrimary" />

</FrameLayout>
